datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  // engineType "client" (stable as of Prisma 7 — driver adapters and the
  // engine-less client no longer need preview-feature flags) drops
  // Prisma's own Rust/WASM query engine entirely, relying only on the `pg`
  // driver adapter (lib/db/prisma.ts) for every query. The query engine's
  // own runtime does environment probing via new Function()/eval(), which
  // Cloudflare Workers blocks outright — that EvalError only ever surfaced
  // in production (Workers), never in local `next dev` (plain Node), which
  // is why this wasn't caught earlier. See README.md ("Deploying to
  // Cloudflare Workers").
  engineType = "client"
}

enum DonationStatus {
  pending
  processing
  succeeded
  failed
  refunded
}

enum PaymentProviderName {
  paystack
  flutterwave
  korapay
  manual
}

enum ContactMessageStatus {
  unread
  read
  replied
}

model Donor {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  address   String?
  createdAt DateTime   @default(now())
  donations Donation[]

  @@index([email])
}

model Cause {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  isDefault   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  donations   Donation[]
}

model Donation {
  id                    String              @id @default(cuid())
  donor                 Donor               @relation(fields: [donorId], references: [id])
  donorId               String
  cause                 Cause               @relation(fields: [causeId], references: [id])
  causeId               String
  amount                Int // smallest currency unit — never a float
  currency              String // ISO 4217, e.g. "NGN", "USD"
  status                DonationStatus      @default(pending)
  provider              PaymentProviderName
  providerReference      String              @unique
  isRecurring           Boolean             @default(false)
  recurringParentId     String?
  isManualEntry         Boolean             @default(false)
  message               String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([provider])
  @@index([createdAt])
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   PaymentProviderName
  eventId    String
  rawPayload Json
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin") // "admin" | "content_editor" — see security.md
  createdAt    DateTime @default(now())
}

// Submissions from the public /contact form. Each one is also emailed to
// CONTACT_INBOX_EMAIL via Resend (see lib/email/resend.ts) — this table is
// the durable record + what the admin dashboard reads, since an inbox
// alone isn't shared/searchable/auditable the way a DB table is.
model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactMessageStatus @default(unread)
  createdAt DateTime             @default(now())

  @@index([status])
  @@index([createdAt])
}

// Real inbound email delivered to ANY @whheritagefoundation.org address
// (contact@, info@, hello@, etc.) — not form submissions. Populated by
// POST /api/webhooks/inbound-email, which the separate workers/email-router
// Cloudflare Worker calls after Cloudflare Email Routing hands it a raw
// message. See workers/email-router/README.md for the required Cloudflare
// dashboard setup this depends on (not something this codebase can do on
// its own — it's DNS/nameserver + Email Routing configuration).
model InboundEmail {
  id          String   @id @default(cuid())
  fromAddress String
  toAddress   String
  subject     String?
  textBody    String?
  htmlBody    String?
  receivedAt  DateTime @default(now())
  isRead      Boolean  @default(false)

  @@index([toAddress])
  @@index([receivedAt])
}
