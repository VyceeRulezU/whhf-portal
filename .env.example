# Copy to .env.local and fill in real values. Never commit the real file.

# Database
DATABASE_URL=

# Admin auth
AUTH_SECRET=
# Optional — only used by `npm run db:seed` to create one bootstrap
# admin account locally. Never set these in a committed file or in a
# shared/production .env; generate a strong password and rotate it after
# first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Korapay
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=

# Transactional email — Resend. See lib/email/resend.ts.
# RESEND_API_KEY: Resend dashboard → API Keys.
# RESEND_FROM_ADDRESS: must be on a domain verified in Resend (Domains →
#   whheritagefoundation.org → DNS records added at the registrar).
# CONTACT_INBOX_EMAIL: where the contact form's notification email is sent.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
CONTACT_INBOX_EMAIL=

# Cloudflare R2 — object storage for site images and general file storage
# (kept separate from Supabase storage to avoid filling its quota). No
# database backup strategy uses this yet — see docs/production-readiness.md
# Phase 3. See lib/storage/r2.ts.
# R2_ACCOUNT_ID: Cloudflare dashboard → R2 → Overview (right sidebar).
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: R2 → Manage API Tokens → Create
#   API Token — scope it to this one bucket only (read+write), not
#   account-wide, per security.md's least-privilege principle.
# R2_BUCKET_NAME: the bucket's exact name as created.
# R2_PUBLIC_URL: the bucket's public r2.dev URL (or a custom domain if one
#   is attached later) — only needed if the bucket serves public assets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Inbound email (any @whheritagefoundation.org address, not just the
# contact form) — see workers/email-router/. This app only receives what
# that separate Cloudflare Worker forwards; generate a long random value
# and set the SAME value as that worker's INBOUND_EMAIL_WEBHOOK_SECRET
# (via `wrangler secret put`), never as a plain var in its wrangler.jsonc.
INBOUND_EMAIL_WEBHOOK_SECRET=

# Cloudflare account-level — only needed to run `wrangler deploy` /
# `wrangler secret put` non-interactively (e.g. workers/email-router).
# Not read by the app itself at runtime.
# CLOUDFLARE_API_TOKEN: My Profile → API Tokens → Create Token, scoped to
#   Account → Workers Scripts → Edit (least-privilege — not the global key).
# CLOUDFLARE_ACCOUNT_ID: right sidebar of any zone/account overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Gates GET /api/cron/keep-alive (see .github/workflows/supabase-keep-alive.yml)
# so it isn't an open, unauthenticated way to spin up DB connections. Set
# the SAME value here and as the CRON_SECRET GitHub Actions repo secret.
CRON_SECRET=

# Sentry (error monitoring) — see docs/production-readiness.md Phase 2.
# Get this from Sentry → your project → Settings → Client Keys (DSN). Not
# secret by design (Sentry's own docs: a DSN is safe to ship in a public
# client bundle) — used both client- and server-side, so the same
# NEXT_PUBLIC_-prefixed var covers both rather than needing two names.
# Sentry.init() is a documented no-op when this is unset, so it's fine to
# leave blank locally/in CI.
NEXT_PUBLIC_SENTRY_DSN=
