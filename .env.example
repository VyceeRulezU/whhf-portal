# Copy to .env.local and fill in real values. Never commit the real file.

# Database
DATABASE_URL=

# Admin auth
AUTH_SECRET=
# Optional — only used by `npm run prisma:seed` to create one bootstrap
# admin account locally. Never set these in a committed file or in a
# shared/production .env; generate a strong password and rotate it after
# first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Korapay
KORAPAY_PUBLIC_KEY=
KORAPAY_SECRET_KEY=
KORAPAY_WEBHOOK_SECRET=

# Transactional email (provider not yet selected — see architecture.md)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
